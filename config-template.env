# VibeCode TestFlight Configuration Template
# Copy this file to .env and fill in your actual values

# Apple Developer Configuration
APPLE_TEAM_ID=YOUR_TEAM_ID_HERE
APPLE_DEVELOPER_ACCOUNT=your-apple-id@example.com
APP_STORE_CONNECT_APP_ID=your-app-store-connect-app-id

# Expo Configuration
EXPO_PROJECT_ID=your-expo-project-id
EXPO_USERNAME=your-expo-username

# App Configuration
APP_BUNDLE_IDENTIFIER=com.vibecode.app
APP_VERSION=1.0.0
IOS_BUILD_NUMBER=1

# Build Configuration
EAS_BUILD_PROFILE=production
IOS_RESOURCE_CLASS=m-medium

# Optional: Development Team (if different from main team)
DEVELOPMENT_TEAM_ID=YOUR_DEVELOPMENT_TEAM_ID

# Optional: Provisioning Profile (if using custom profiles)
IOS_PROVISIONING_PROFILE=your-provisioning-profile-name

# Optional: Distribution Certificate (if using custom certificates)
IOS_DISTRIBUTION_CERTIFICATE=your-distribution-certificate-name